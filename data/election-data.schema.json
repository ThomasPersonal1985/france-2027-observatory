{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observatoire2027.fr/schemas/election-data.schema.json",
  "title": "France 2027 election dataset",
  "description": "Structural contract for data/election-data.json. Cross-record and strict date checks are implemented by scripts/validate_election_data.py.",
  "type": "object",
  "required": ["meta", "candidates", "debates", "policy_positions", "polls", "news", "events", "sources", "updates", "poll_trends", "media_directory", "editorial_standards", "compass_questions", "compass_methodology"],
  "properties": {
    "meta": {"type":"object","required":["title","last_updated","data_version"],"properties":{"title":{"type":"string","minLength":1},"last_updated":{"$ref":"#/$defs/date"},"data_version":{"anyOf":[{"type":"string","minLength":1},{"type":"integer","minimum":1}]}},"additionalProperties":true},
    "candidates": {"type":"array","items":{"$ref":"#/$defs/candidate"}},
    "debates": {"type":"array","items":{"type":"object","required":["date","title","participants","source"],"properties":{"date":{"$ref":"#/$defs/date"},"title":{"type":"string","minLength":1},"participants":{"type":"array","items":{"type":"string"}},"source":{"$ref":"#/$defs/citation"}},"additionalProperties":true}},
    "policy_positions": {"type":"array","items":{"$ref":"#/$defs/policy"}},
    "polls": {"type":"array","items":{"$ref":"#/$defs/poll"}},
    "news": {"type":"array","items":{"$ref":"#/$defs/news"}},
    "events": {"type":"array","items":{"type":"object","required":["date","title","status"],"properties":{"date":{"$ref":"#/$defs/date"},"title":{"type":"string","minLength":1},"status":{"type":"string","minLength":1}},"additionalProperties":true}},
    "sources": {"type":"array","items":{"$ref":"#/$defs/citation"}},
    "updates": {"type":"array","items":{"type":"object","required":["date","summary"],"properties":{"date":{"$ref":"#/$defs/date"},"summary":{"type":"string","minLength":1}},"additionalProperties":true}},
    "poll_trends": {"type":"array","items":{"$ref":"#/$defs/trend"}},
    "media_directory": {"type":"array","items":{"type":"object","required":["publisher","url","type"],"properties":{"publisher":{"type":"string","minLength":1},"url":{"$ref":"#/$defs/url"},"type":{"type":"string","minLength":1}},"additionalProperties":true}},
    "editorial_standards": {"type":"object"},
    "compass_questions": {"type":"array","items":{"type":"object","required":["id","topic","title","options","max","stage"],"properties":{"id":{"type":"string","minLength":1},"topic":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},"options":{"type":"array","minItems":2},"max":{"type":"number","exclusiveMinimum":0},"stage":{"enum":["standard","extended"]}},"additionalProperties":true}},
    "compass_methodology": {"type":"object"}
  },
  "additionalProperties": true,
  "$defs": {
    "date":{"type":"string","format":"date","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "url":{"type":"string","format":"uri","pattern":"^https?://"},
    "citation":{"type":"object","required":["title","url","type"],"properties":{"title":{"type":"string","minLength":1},"url":{"$ref":"#/$defs/url"},"type":{"type":"string","minLength":1}},"additionalProperties":true},
    "candidate":{"type":"object","required":["id","name","party","campaign_status","ballot_status","sources"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"name":{"type":"string","minLength":1},"party":{"type":"string","minLength":1},"campaign_status":{"type":"string","minLength":1},"ballot_status":{"type":"string","minLength":1},"sources":{"type":"array","items":{"$ref":"#/$defs/citation"}}},"additionalProperties":true},
    "poll":{"type":"object","required":["publication_date","fieldwork_start","fieldwork_end","pollster","sponsor","sample_size","scenario","results","source"],"properties":{"publication_date":{"$ref":"#/$defs/date"},"fieldwork_start":{"$ref":"#/$defs/date"},"fieldwork_end":{"$ref":"#/$defs/date"},"pollster":{"type":"string","minLength":1},"sponsor":{"type":"string","minLength":1},"sample_size":{"type":"integer","minimum":1},"scenario":{"type":"string","minLength":1},"results":{"type":"object","minProperties":1,"additionalProperties":{"type":"number","minimum":0,"maximum":100}},"source":{"$ref":"#/$defs/citation"}},"additionalProperties":true},
    "news":{"type":"object","required":["publication_date","title","publisher","language","topic","summary","source","verification"],"properties":{"publication_date":{"$ref":"#/$defs/date"},"title":{"type":"string","minLength":1},"publisher":{"type":"string","minLength":1},"language":{"type":"string","minLength":1},"topic":{"type":"string","minLength":1},"summary":{"type":"string","minLength":1},"source":{"$ref":"#/$defs/citation"},"verification":{"type":"object","required":["status"],"properties":{"status":{"type":"string","minLength":1},"checked_date":{"anyOf":[{"$ref":"#/$defs/date"},{"type":"null"}]}},"additionalProperties":true}},"additionalProperties":true},
    "policy":{"type":"object","required":["candidate_name","topic","position","evidence_type","source","verification_status","checked_date"],"properties":{"candidate_name":{"type":"string","minLength":1},"topic":{"type":"string","minLength":1},"position":{"type":"string","minLength":1},"evidence_type":{"type":"string","minLength":1},"source":{"$ref":"#/$defs/citation"},"verification_status":{"type":"string","minLength":1},"checked_date":{"anyOf":[{"$ref":"#/$defs/date"},{"type":"null"}]}},"additionalProperties":true},
    "trend":{"type":"object","required":["candidate","average","polls_count","snapshot_date","method"],"properties":{"candidate":{"type":"string","minLength":1},"average":{"type":"number","minimum":0,"maximum":100},"polls_count":{"type":"integer","minimum":1},"snapshot_date":{"$ref":"#/$defs/date"},"method":{"type":"string","minLength":1}},"additionalProperties":true}
  }
}
