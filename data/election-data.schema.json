{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observatoire2027.fr/schemas/election-data.schema.json",
  "title": "France 2027 election dataset",
  "description": "Structural contract for data/election-data.json. Cross-record and strict date checks are implemented by scripts/validate_election_data.py.",
  "type": "object",
  "required": [
    "meta",
    "candidates",
    "debates",
    "policy_positions",
    "polls",
    "news",
    "events",
    "sources",
    "source_registry",
    "updates",
    "poll_trends",
    "media_directory",
    "editorial_standards",
    "compass_questions",
    "compass_methodology",
    "poll_trend_snapshots"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "title",
        "last_updated",
        "data_version"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "last_updated": {
          "$ref": "#/$defs/date"
        },
        "data_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "debates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "title",
          "participants",
          "source"
        ],
        "properties": {
          "date": {
            "$ref": "#/$defs/date"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "participants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "$ref": "#/$defs/citation"
          }
        },
        "additionalProperties": true
      }
    },
    "policy_positions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy"
      }
    },
    "polls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/poll"
      }
    },
    "news": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/news"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "title",
          "status"
        ],
        "properties": {
          "date": {
            "$ref": "#/$defs/date"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "source_registry": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/registrySource"
      }
    },
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "summary"
        ],
        "properties": {
          "date": {
            "$ref": "#/$defs/date"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "poll_trends": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trend"
      }
    },
    "media_directory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "publisher",
          "url",
          "type"
        ],
        "properties": {
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "$ref": "#/$defs/url"
          },
          "type": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "editorial_standards": {
      "type": "object"
    },
    "compass_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "topic",
          "title",
          "options",
          "max",
          "stage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 2
          },
          "max": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "stage": {
            "enum": [
              "standard",
              "extended"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "compass_methodology": {
      "type": "object"
    },
    "poll_trend_snapshots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trendSnapshot"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "citation": {
      "type": "object",
      "required": [
        "title",
        "url",
        "type",
        "source_id"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "pattern": "^src-[a-f0-9]{16}$"
        }
      },
      "additionalProperties": true
    },
    "registrySource": {
      "type": "object",
      "required": [
        "id",
        "title",
        "url",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^src-[a-f0-9]{16}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "required": [
        "code",
        "checked_date",
        "reviewer"
      ],
      "properties": {
        "code": {
          "enum": [
            "unreviewed",
            "secondary_only",
            "primary_verified",
            "disputed",
            "superseded"
          ]
        },
        "checked_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "candidate": {
      "type": "object",
      "required": [
        "id",
        "name",
        "party",
        "campaign_status",
        "ballot_status",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "party": {
          "type": "string",
          "minLength": 1
        },
        "campaign_status": {
          "type": "string",
          "minLength": 1
        },
        "ballot_status": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        }
      },
      "additionalProperties": true
    },
    "poll": {
      "type": "object",
      "required": [
        "id",
        "scenario_id",
        "scenario_type",
        "publication_date",
        "fieldwork_start",
        "fieldwork_end",
        "pollster",
        "sponsor",
        "sample_size",
        "scenario",
        "results",
        "candidate_ids",
        "source",
        "source_provenance",
        "verification",
        "survey_methodology"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^poll-[a-f0-9]{16}$"
        },
        "scenario_id": {
          "type": "string",
          "pattern": "^first-round-lineup-[a-f0-9]{12}$"
        },
        "scenario_type": {
          "const": "first_round"
        },
        "publication_date": {
          "$ref": "#/$defs/date"
        },
        "fieldwork_start": {
          "$ref": "#/$defs/date"
        },
        "fieldwork_end": {
          "$ref": "#/$defs/date"
        },
        "pollster": {
          "type": "string",
          "minLength": 1
        },
        "sponsor": {
          "type": "string",
          "minLength": 1
        },
        "sample_size": {
          "type": "integer",
          "minimum": 1
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "results": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "candidate_ids": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "source_provenance": {
          "type": "object",
          "required": [
            "cited_source_type",
            "secondary_archive_source_id",
            "original_poll_notice_source_id"
          ],
          "properties": {
            "cited_source_type": {
              "enum": [
                "primary_pollster_notice",
                "secondary_archive"
              ]
            },
            "secondary_archive_source_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^src-[a-f0-9]{16}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "original_poll_notice_source_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^src-[a-f0-9]{16}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": true
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "survey_methodology": {
          "type": "object",
          "required": [
            "question_wording",
            "collection_mode",
            "margin_of_error",
            "sampling_frame"
          ],
          "properties": {
            "question_wording": {
              "type": [
                "string",
                "null"
              ]
            },
            "collection_mode": {
              "type": [
                "string",
                "null"
              ]
            },
            "margin_of_error": {
              "type": [
                "string",
                "number",
                "null"
              ]
            },
            "sampling_frame": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "news": {
      "type": "object",
      "required": [
        "publication_date",
        "title",
        "publisher",
        "language",
        "topic",
        "summary",
        "source",
        "verification"
      ],
      "properties": {
        "publication_date": {
          "$ref": "#/$defs/date"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      },
      "additionalProperties": true
    },
    "policy": {
      "type": "object",
      "required": [
        "candidate_name",
        "topic",
        "position",
        "evidence_type",
        "source",
        "verification_status",
        "checked_date",
        "verification"
      ],
      "properties": {
        "candidate_name": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "string",
          "minLength": 1
        },
        "evidence_type": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "verification_status": {
          "type": "string",
          "minLength": 1
        },
        "checked_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      },
      "additionalProperties": true
    },
    "trend": {
      "type": "object",
      "required": [
        "candidate",
        "candidate_id",
        "id",
        "snapshot_id",
        "source_id",
        "average",
        "polls_count",
        "snapshot_date",
        "method"
      ],
      "properties": {
        "candidate": {
          "type": "string",
          "minLength": 1
        },
        "average": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "polls_count": {
          "type": "integer",
          "minimum": 1
        },
        "snapshot_date": {
          "$ref": "#/$defs/date"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "id": {
          "type": "string",
          "pattern": "^trend-"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^snapshot-"
        },
        "source_id": {
          "type": "string",
          "pattern": "^src-[a-f0-9]{16}$"
        }
      },
      "additionalProperties": true
    },
    "trendSnapshot": {
      "type": "object",
      "required": [
        "id",
        "snapshot_date",
        "provider",
        "source_id",
        "calculation_type",
        "method",
        "algorithm_version",
        "algorithm_version_status",
        "input_poll_ids",
        "input_status",
        "scenario_id",
        "scenario_note",
        "observation_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^snapshot-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-f0-9]{12}$"
        },
        "snapshot_date": {
          "$ref": "#/$defs/date"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "pattern": "^src-[a-f0-9]{16}$"
        },
        "calculation_type": {
          "enum": [
            "external_provider",
            "site_calculated"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "algorithm_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "algorithm_version_status": {
          "enum": [
            "published",
            "not_published",
            "not_applicable"
          ]
        },
        "input_poll_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^poll-[a-f0-9]{16}$"
          }
        },
        "input_status": {
          "enum": [
            "linked",
            "not_provided",
            "not_applicable"
          ]
        },
        "scenario_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^first-round-lineup-[a-f0-9]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "scenario_note": {
          "type": "string",
          "minLength": 1
        },
        "observation_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^trend-"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "calculation_type": {
                "const": "site_calculated"
              }
            },
            "required": [
              "calculation_type"
            ]
          },
          "then": {
            "properties": {
              "algorithm_version": {
                "type": "string",
                "minLength": 1
              },
              "algorithm_version_status": {
                "const": "published"
              },
              "input_status": {
                "const": "linked"
              },
              "input_poll_ids": {
                "minItems": 1
              },
              "scenario_id": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "calculation_type": {
                "const": "external_provider"
              }
            },
            "required": [
              "calculation_type"
            ]
          },
          "then": {
            "properties": {
              "input_status": {
                "enum": [
                  "not_provided",
                  "linked"
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  }
}
